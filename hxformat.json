{
	"lineEnds": {
		"leftCurly": "both",
		"rightCurly": "both",
		"emptyCurly": "noBreak",
		"objectLiteralCurly": {
			"leftCurly": "after"
		}
	},
	"sameLine": {
		"ifElse": "next",
		"doWhile": "next",
		"tryBody": "next",
		"tryCatch": "next"
	},
	"emptyLines": {
		"importAndUsing": {
			"betweenImportsLevel": "firstLevelPackage",
			"betweenImports": 1,
			"beforeType": 1,
			"beforeUsing": 1
		}
	},
	"indentation": {
		"trailingWhitespace": false
	},
	"wrapping": {
		"arrayWrap": {
			"defaultWrap": "keep"
		},
		"maxLineLength": 600
	}
}
