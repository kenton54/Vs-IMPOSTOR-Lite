import hxp.*;
import lime.tools.*;
import haxe.ds.Map;
import haxe.io.Bytes;
import haxe.io.Path;
import sys.io.File;
import sys.io.Process;
import sys.FileSystem;

using StringTools;

class Project extends HXProject
{
    /**
     * The version of the application.
     */
    static final VERSION:String = "1.0";

    static final BUILD_NUMBER:Int = 1;

    /**
     * The title of the application.
     */
    static final TITLE:String = "VS IMPOSTOR: Lite";

    /**
     * The name of the executable file.
     *
     * For Desktop targets.
     */
    static final EXECUTABLE_NAME:String = "ImpostorLite";

    /**
     * The unique package name for this project.
     *
     * For Android applications.
     */
    static final PACKAGE_NAME:String = "com.gtm.impostorlite";

    /**
     * The company name behind this project.
     */
    static final COMPANY:String = "GTM";

    /**
     * The path to the class that installs the application and caches most of the assets.
     */
    static final PRELOADER_CLASS_PATH:String = "flixel.system.FlxPreloader";

    /**
     * The path to the class that setups and starts the game.
     */
    static final MAIN_CLASS_PATH:String = "Main";

    /**
     * The minimum Android SDK version this application can launch on.
     *
     * SDK 28 is Android 9.0, codenamed "Pie".
     */
    static final ANDROID_MINIMUM_SDK:Int = 28;

    /**
     * The Android SDK version this application is targetting.
     *
     * In other words, the Android SDK version this application is built on.
     *
     * SDK 35 is Android 15.0, codenamed "VanillaIceCream".
     */
    static final ANDROID_TARGET_SDK:Int = 35;

    // ---------- FEATURE FLAGS ---------- //

    /**
     * If enabled, compiles with a crash handler, has minor impact on performance.
     */
    static final CRASH_HANDLER:FeatureFlag = 'CRASH_HANDLER';

    /**
     * If enabled, the engine's exclusive debug tools can be accessed.
     */
    static final EDITORS_ALLOWED:FeatureFlag = 'EDITORS_ALLOWED';

    /**
     * If enabled, the Discord Rich Presence API will be accessible on targets that support it.
     */
    static final DISCORD_ALLOWED:FeatureFlag = 'DISCORD_ALLOWED';

    /**
     * If enabled, the Video Playback Backend will be accessible on targets that support it.
     */
    static final VIDEOS_ALLOWED:FeatureFlag = 'VIDEOS_ALLOWED';

    /**
     * Whether to build with the Haxe Scripting API.
     */
    static final HSCRIPT_ALLOWED:FeatureFlag = 'HSCRIPT_ALLOWED';

    /**
     * Whether to build with the Lua Scripting API.
     */
    static final LUA_ALLOWED:FeatureFlag = 'LUA_ALLOWED';

    /**
     * Takes care of making it possible for HXVLC to compile if certain conditions are met.
     */
    var canHxvlcCompile:Bool = true;

    public function new()
    {
        super();

        if (!isDisplay())
        {
            displayBuildInformation();
        }

        setupApplication();
        setupExport();
        setupDefines();
        setupLibraries();
        setupAssets();

        if (!isLinux())
        {
            setupIcons();
        }

        if (isAndroid())
        {
            setupAndroid();
        }

        if (isIOS())
        {
            setupIOS();
        }

        if (isCPP())
        {
            buildHXCPPTools();
        }
    }

    function displayBuildInformation()
	{
		var fullInfo:Array<String> = [];
		fullInfo.push('');
		fullInfo.push('============================================================');
		fullInfo.push('');
		fullInfo.push('                     Build Information');
		fullInfo.push('');

		var platformTargetStr:String = '';
		switch(this.target)
		{
			case Platform.WINDOWS: platformTargetStr = 'Windows';
			case Platform.LINUX: platformTargetStr = 'Linux';
			case Platform.MAC: platformTargetStr = 'MacOS';
			case Platform.ANDROID: platformTargetStr = 'Android';
			case Platform.IOS: platformTargetStr = 'iOS';
			case Platform.TVOS: platformTargetStr = 'tvOS';
			case Platform.HTML5: platformTargetStr = 'HTML5';
			case Platform.WEB_ASSEMBLY: platformTargetStr = 'Web Assembly';
			case Platform.WEBOS: platformTargetStr = 'webOS';
			case Platform.AIR: platformTargetStr = 'Adobe AIR';
			case Platform.FLASH: platformTargetStr = 'Flash';
			default: platformTargetStr = 'Unknown';
		}
		fullInfo.push('Platform Target: $platformTargetStr');

		var platformTypeStr:String = '';
		switch(this.platformType)
		{
			case PlatformType.DESKTOP: platformTypeStr = 'Desktop';
			case PlatformType.MOBILE: platformTypeStr = 'Mobile';
			case PlatformType.WEB: platformTypeStr = 'Web';
			case PlatformType.CONSOLE: platformTypeStr = 'Console';
			default: platformTypeStr = 'Unknown';
		}
		fullInfo.push('Platform Type: $platformTypeStr');

		var languageTargetStr:String = '';
		if (isWeb())
			languageTargetStr = 'JavaScript (HTML5)';
		else if (isHashLink())
			languageTargetStr = 'HashLink';
		else if (isNeko())
			languageTargetStr = 'Neko';
		else if (isCPP())
			languageTargetStr = 'C++';
		else if (isNodeJS())
			languageTargetStr = 'JavaScript (NodeJS)';
		else
			error('Unsupported target language!');

		fullInfo.push('Language Target: $languageTargetStr');

		var architecturesStr:Array<String> = [];
		for (arch in this.architectures)
		{
			switch(arch)
			{
				case Architecture.ARMV5: architecturesStr.push('ARMv5');
				case Architecture.ARMV6: architecturesStr.push('ARMv6');
				case Architecture.ARMV7: architecturesStr.push('ARMv7');
				case Architecture.ARMV7S: architecturesStr.push('ARMv7S');
				case Architecture.ARM64: architecturesStr.push('ARMx64');
				case Architecture.X86: architecturesStr.push('x86');
				case Architecture.X64: architecturesStr.push('x64');
				case Architecture.MIPS: architecturesStr.push('MIPS');
				case Architecture.MIPSEL: architecturesStr.push('MIPSEL');
				case null: if (isWeb()) architecturesStr.push('Web');
				default:
					error('Unsupported architecture! (got $arch)');
			}
		}

		if (architecturesStr.length >= 1)
		{
			fullInfo.push('Architectures: ${architecturesStr.join(', ')}');
		}

		fullInfo.push('');
		fullInfo.push('============================================================');
		fullInfo.push('');

		for (buildInfo in fullInfo)
		{
			infoBlank(buildInfo);
		}
	}

    function setupApplication()
    {
        meta.version = VERSION;
        meta.buildNumber = Std.string(BUILD_NUMBER);

        meta.title = TITLE;
        if (isIOS()) meta.title = ~/ /ig.replace(TITLE, "\u2002");

        meta.company = COMPANY;
        meta.packageName = PACKAGE_NAME;

        sources.push("source");

        app.main = MAIN_CLASS_PATH;
        app.file = EXECUTABLE_NAME;
        app.preloader = PRELOADER_CLASS_PATH;

        window.fps = 60;
        window.width = 1200;
        window.height = 900;

        window.orientation = isWeb() ? Orientation.AUTO : Orientation.LANDSCAPE;

        window.vsync = false;
        window.hardware = true;
        window.allowHighDPI = !isMacOS();

        if (isWeb())
        {
            window.resizable = true;
        }

        if (isDesktop())
        {
            window.resizable = true;
            window.fullscreen = false;
        }

        if (isMobile())
        {
            window.resizable = false;
            window.fullscreen = true;
            window.borderless = true;
            window.width = 0;
            window.height = 0;
        }

        if (isAndroid())
        {
            config.set("android.minimum-sdk-version", ANDROID_MINIMUM_SDK);
            config.set("android.target-sdk-version", ANDROID_TARGET_SDK);
        }

        window.background = 0xFFFFFFFF;

        preBuildCallbacks.push(createHaxeCLICommand('setup/scripts/BuildTimeTrackerStart.hx'));
		postBuildCallbacks.push(createHaxeCLICommand('setup/scripts/BuildTimeTrackerFinish.hx'));
    }

    function setupExport()
    {
        var exportPath:String = 'export/${isDebug() ? "debug" : "release"}';
        app.path = exportPath;
    }

    function setupDefines()
    {
        setHaxeDefine('LINC_LUA_RELATIVE_DYNAMIC_LIB');

        // first dont compile stuff we are never gonna use
        removeHaxeDefine("FLX_RECORD");
        setHaxeDefine("FLX_NO_FOCUS_LOST_SCREEN");

        CRASH_HANDLER.apply(this, true);
        EDITORS_ALLOWED.apply(this, !isMobile());
        DISCORD_ALLOWED.apply(this, isDesktop() && isCPP());
        VIDEOS_ALLOWED.apply(this, isWeb() || isDesktop() || isMobile());
        HSCRIPT_ALLOWED.apply(this, true);
        LUA_ALLOWED.apply(this, isCPP()); // it only cares if C++ is available

        canHxvlcCompile = VIDEOS_ALLOWED.isEnabled(this) && !isWeb() && isCPP();

        if (CRASH_HANDLER.isEnabled(this))
        {
            setHaxeDefine("openfl-enable-handle-error");
            setHaxeDefine("HXCPP_CHECK_POINTER");
            setHaxeDefine("HXCPP_STACK_LINE");
            setHaxeDefine("HXCPP_STACK_TRACE");
        }

        if (DISCORD_ALLOWED.isEnabled(this))
        {
            setHaxeDefine("DISCORD_DISABLE_IO_THREAD");
        }

        if (canHxvlcCompile)
        {
            if (isDebug())
            {
                setHaxeDefine("HXC_LIBVLC_LOGGING");
            }

            setHaxeDefine("HXVLC_NO_SHARE_DIRECTORY");
        }

        if (HSCRIPT_ALLOWED.isEnabled(this))
        {
            setHaxeDefine("hscriptPos");
        }

        if (isLinux())
        {
            setHaxeDefine("NO_PRECOMPILED_HEADERS");
        }

        if (isRelease())
        {
            setHaxeDefine("analyzer-optimize");
            setHaxeDefine("FLX_NO_DEBUG");
            setHaxeDefine("NAPE_RELEASE_BUILD");
        }

        setHaxeDefine("lime_disable_assets_version");
        setHaxeDefine("message.reporting", "pretty");

        setHaxeDefine("no-deprecation-warnings");

        addHaxeFlag("-dce no");
    }

    function setupLibraries()
    {
        addHaxelib("flixel");
        addHaxelib("flixel-addons");
        addHaxelib("flixel-ui");

        if (LUA_ALLOWED.isEnabled(this))
        {
            addHaxelib("linc_luajit");
        }

        if (HSCRIPT_ALLOWED.isEnabled(this))
        {
            addHaxelib("hscript-iris");
        }

        if (DISCORD_ALLOWED.isEnabled(this))
        {
            addHaxelib("hxdiscord_rpc");
        }

        if (canHxvlcCompile)
        {
            addHaxelib("hxvlc");
        }

        if (isMobile())
        {
            if (isAndroid())
            {
                addHaxelib("extension-androidtools");
            }
        }

        if (isDebug())
        {
            addHaxelib("hxcpp-debug-server");
        }

        if (isLinux())
        {
            addHaxelib("hxgamemode");
        }
    }

    function setupAssets()
    {
        var preloadAssets:Bool = !isWeb();
        var embedAssets:Bool = isWeb();

        addAssetLibrary("default", embedAssets, preloadAssets);
        addAssetPath("assets/lite", null, "default", ["*"], [], embedAssets, "assets");
        addAssetPath("assets/fonts", null, "default", ["*"], [], true, "assets");

        addAssetLibrary("songs", embedAssets, preloadAssets);
        addAssetPath("assets/lite/data/songs", null, "songs", ["*"], [], embedAssets, "assets");

        addAssetLibrary("videos", false, false);
        addAssetPath("assets/lite/videos", null, "videos", ["*"], [], false, "assets");

        addAsset("setup/readme.txt", "funkin_readme.txt", null, false);

        if (isLinux())
        {
            addAsset("setup/icons/iconOG.png", "icon.png", null, false);
        }
    }

    function setupIcons()
    {
        if (isAndroid())
        {
            recursiveCopyDirectory('setup/icons/android/', '${app.path}/android/bin/app/src/main/res/', templateContext);
        }
        else
        {
            addIcon("setup/icons/icon16.png", 16);
            addIcon("setup/icons/icon64.png", 64);
            addIcon("setup/icons/icon150.png", 160);
            addIcon("setup/icons/icon300.png", 320);
            addIcon("setup/icons/iconOG.png");
        }
    }

    function setupAndroid()
    {
        if (isRelease())
        {
            if (isBundle())
            {
                config.set("android.gradle-project-directory", "bin-bundle");
            }
        }

        config.set("android.application.android:icon", "@mipmap/ic_launcher");
        config.set("android.application.android:roundIcon", "@mipmap/ic_launcher_round");

        config.set("android.layoutInDisplayCutoutMode", "shortEdges");
    }

    function setupIOS()
    {
        config.set("ios.deployment", "16.0");
        config.set("ios.non-exempt-encryption", false);
    }

    /**
     * Isn't it annoying when HXCPP asks you to set it up every single time you install it or update it?
     *
     * Here we do it for you! cuz seriously this annoys me so much as well lol.
     *
     * *Also prevents GitHub workflows from failing*
     */
    function buildHXCPPTools()
    {
        var path:String = getLibraryPath("hxcpp");

        if (path.toLowerCase().startsWith("error") || !FileSystem.exists(path))
        {
            error('Couldn\'t find the library "hxcpp" while targetting C++! Is it installed?');
        }

        var hxcppN:String = Path.join([path, "hxcpp.n"]);

        if (FileSystem.exists(hxcppN))
        {
            // hxcpp build tools were already set up
            return;
        }

        var toolsPath:String = Path.join([path, "tools/hxcpp"]);
        var oldDirectory:String = Sys.getCwd();
        Sys.setCwd(toolsPath);

        var process = new Process('haxe', ['compile.hxml']);

        if (process.exitCode() != 0)
        {
            info("Couldn't compile HXCPP Tools. Is HXCPP installed properly?");
        }

        process.close();

        Sys.setCwd(oldDirectory);
    }

    public function addHaxelib(name:String, version:String = ""):Void
    {
        haxelibs.push(new Haxelib(name, version));
    }

    public function addHaxeFlag(value:String):Void
    {
        haxeflags.push(value);
    }

    public function addHaxeMacro(value:String):Void
    {
        addHaxeFlag('--macro $value');
    }

    public function setHaxeDefine(name:String, ?value:String = ""):Void
    {
        haxedefs.set(name, value);
    }

    public function hasHaxeDefine(name:String):Bool
    {
        return haxedefs.exists(name);
    }

    public function removeHaxeDefine(name:String):Void
    {
        haxedefs.remove(name);
    }

    public function addAssetLibrary(name:String, embed:Bool = false, preload:Bool = false):Void
    {
        libraries.push(new Library("", name, null, embed, preload, false, ""));
    }

    public function addAssetPath(path:String, ?rename:String, library:String, ?include:Array<String>, ?exclude:Array<String>, embed:Bool = false, ?padName:String):Void
    {
        if (path == "") return;
        if (include == null) include = [];
        if (exclude == null) exclude = [];

        var targetPath:String = rename ?? path;
        if (targetPath != "") targetPath += "/";

        if (!FileSystem.exists(path))
        {
            error('Asset path "$path" doesn\'t exists!');
        }
        else if (!FileSystem.isDirectory(path))
        {
            error('Asset path "$path" is not a directory!');
        }

        for (file in FileSystem.readDirectory(path))
        {
            if (FileSystem.isDirectory('$path/$file'))
            {
                if (filter(file, ["*"], exclude))
                {
                    addAssetPath('$path/$file', '$targetPath$file', library, include, exclude, embed, padName);
                }
            }
            else
            {
                if (filter(file, include, exclude))
                {
                    addAsset('$path/$file', '$targetPath$file', library, embed, padName);
                }
            }
        }
    }

    public function addAsset(path:String, ?rename:String, ?library:String, embed:Bool = false, ?padName:String):Void
    {
        var asset:Asset = new Asset(path, rename, null, embed, true);
        asset.library = library ?? "default";
        assets.push(asset);
    }

    public function addIcon(icon:String, ?size:Int):Void
    {
        icons.push(new Icon(icon, size));
    }

    public function recursiveCopyDirectory(source:String, destination:String, context:String = null, process:Bool = true, warnIfNotFound:Bool = true)
    {
        if (!FileSystem.exists(source))
        {
            if (warnIfNotFound)
            {
                warn('Could not find directory "$source"');
            }

            return;
        }

        for (item in FileSystem.readDirectory(source))
        {
            var itemSource:String = Path.combine(source, item);
            var itemDestination:String = Path.combine(destination, item);

            if (FileSystem.isDirectory(itemSource))
            {
                recursiveCopyDirectory(itemSource, itemDestination, context, process, warnIfNotFound);
            }
            else
            {
                FileSystem.createDirectory(Path.directory(itemDestination));
                System.copyFile(itemSource, itemDestination, context, process);
            }
        }
    }

    public function createHaxeCLICommand(path:String):CLICommand
	{
		return CommandHelper.interpretHaxe(path);
	}

    public function isDesktop():Bool
    {
        return platformType == PlatformType.DESKTOP;
    }

    public function isMobile():Bool
    {
        return platformType == PlatformType.MOBILE;
    }

    public function isWeb():Bool
    {
        return platformType == PlatformType.WEB;
    }

    public function isConsole():Bool
    {
        return platformType == PlatformType.CONSOLE;
    }

    public function isWindows():Bool
    {
        return target == Platform.WINDOWS;
    }

    public function isLinux():Bool
    {
        return target == Platform.LINUX;
    }

    public function isMacOS():Bool
    {
        return target == Platform.MAC;
    }

    public function isHTML5():Bool
    {
        return target == Platform.HTML5;
    }

    public function isAndroid():Bool
    {
        return target == Platform.ANDROID;
    }

    public function isAndroidEmulator():Bool
    {
        return target == Platform.ANDROID && (targetFlags.exists("emulator") || targetFlags.exists("simulator"));
    }

    public function isIOS():Bool
    {
        return target == Platform.IOS;
    }

    public function isIOSSimulator():Bool
    {
        return target == Platform.IOS && targetFlags.exists("simulator");
    }

    public function isHashLink():Bool
    {
        return targetFlags.exists("hl");
    }

    public function isNeko():Bool
    {
        return targetFlags.exists("neko");
    }

    public function isCPP():Bool
    {
        return defines.exists("cpp");
    }

    public function isNodeJS():Bool
    {
        return targetFlags.exists("nodejs");
    }

    public function isDebug():Bool
    {
        return this.debug;
    }

    public function isRelease():Bool
    {
        return !isDebug();
    }

    public function isBundle():Bool
    {
        return targetFlags.exists("bundle") && isAndroid();
    }

    public function isDisplay():Bool
    {
        return command == "display";
    }

    public function isClean():Bool
    {
        return command == "clean";
    }

    public function isBuild():Bool
    {
        return command == "test" || command == "build";
    }

    public function getLibraryPath(library:String):String
    {
        var process = new Process('haxelib', ['libpath', library]);
        return process.stdout.readLine();
    }

    public inline function info(message:String)
	{
		infoBlank('[INFO]: $message');
	}

	public function infoBlank(message:String)
	{
		if (!(isDisplay() || isClean()))
		{
			Sys.println(message);
		}
	}

    public function warn(message:String)
    {
        if (!(isDisplay() || isClean()))
        {
            Sys.println('[WARNING]: $message');
        }
    }

    public function error(message:String)
    {
        Sys.stderr().write(Bytes.ofString('[ERROR] $message\n'));
        Sys.exit(1);
    }
}

/**
 * An object representing a feature flag, which can be enabled or disabled.
 *
 * More info about features flags in here: https://haxe.org/manual/lf-condition-compilation.html
 */
abstract FeatureFlag(String) from String to String
{
	public function new(input:String)
	{
		this = input;
	}

	/**
	 * Applies this feature flag to the specified project.
	 *
	 * @param project       The lime project.
	 * @param mustEnable    A set of conditions to meet. Defaults to `false`.
	 */
	public function apply(project:Project, mustEnable:Bool = false)
	{
		if (!isEnabled(project))
		{
			if (mustEnable)
			{
				enable(project);
			}
			else
			{
				disable(project);
			}
		}
	}

	/**
	 * Enables this feature flag to the project.
	 * @param project The lime project.
	 */
	public function enable(project:Project)
	{
		project.setHaxeDefine(this);
	}

	/**
	 * Disables this feature flag from the project.
	 * @param project The lime project.
	 */
	public function disable(project:Project)
	{
		project.removeHaxeDefine(this);
	}

	/**
	 * Checks whether this feature flag is enabled in the project
	 * @param project The lime project.
	 */
	public function isEnabled(project:Project):Bool
	{
		return project.hasHaxeDefine(this) || project.defines.exists(this);
	}
}
